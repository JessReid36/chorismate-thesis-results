|  3> %pal nprocs 8 end
|  4> %scf MaxIter 300 end
|  5> %output Print[P_Loewdin] 1 end
|  6> %pointcharges "20000_TS_d2.8.pc"
|  7> * xyzfile -2 1 20000_TS.xyz
|  8> 
