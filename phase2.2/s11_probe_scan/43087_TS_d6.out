|  4> %scf MaxIter 300 end
|  5> %output Print[P_Loewdin] 1 end
|  6> %pointcharges "43087_TS_d6.pc"
|  7> * xyzfile -2 1 43087_TS.xyz
|  8> 
|  9>                          ****END OF INPUT****
