|  2> %maxcore 3000
|  3> %pal nprocs 8 end
|  4> %scf MaxIter 300 end
|  5> %output Print[P_Loewdin] 1 end
|  6> %pointcharges "24883_TS_d6.pc"
|  7> * xyzfile -2 1 24883_TS.xyz
|  8> 
|  9>                          ****END OF INPUT****
