#!/bin/bash
#PBS -N cm_d42
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d42/run.pbs.out
# Stage 6 DIAGNOSTIC 42: is the dianion bound with the charges of D31's RELIABLE conditions?
# C_bare_R is D40's committed monoanion input for the bare substrate, byte for byte: the CONTROL.
# Every other run is a monoanion, charge -1 multiplicity 2: a committed dianion input of D31's
#   arm B with that one line changed, beside its own geometry and point-charge file.
# Order: the control; the 8 conditions whose charges sum to zero or more, both states; then
#   the 5 whose charges sum to less than zero. A run that fails does not stop the ones after it.
# No -q: the allocation is automatic and walltime 24:00:00 routes to day. Restartable.
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d42
cd "$W" || exit 1
if ! mkdir .running 2>/dev/null; then echo "FAIL: another job holds .running in $W"; exit 1; fi
trap 'rmdir "$W/.running" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
echo "free memory at start:"; free -g | head -2
run() {
  d="$W/$1"
  if [ -s "$d/job.out" ] && grep -q "ORCA TERMINATED NORMALLY" "$d/job.out"; then echo "$1 done before"
  else ( cd "$d" && "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
run C_bare_R
run n01_q0.25_R
run n01_q0.25_TS
run n02_q0.25_R
run n02_q0.25_TS
run n10_q0.25_R
run n10_q0.25_TS
run n20_q0.25_R
run n20_q0.25_TS
run n01_q0.50_R
run n01_q0.50_TS
run n02_q0.50_R
run n02_q0.50_TS
run n01_q0.75_R
run n01_q0.75_TS
run n02_q0.75_R
run n02_q0.75_TS
run n03_q0.25_R
run n03_q0.25_TS
run n05_q0.25_R
run n05_q0.25_TS
run n03_q0.50_R
run n03_q0.50_TS
run n05_q0.50_R
run n05_q0.50_TS
run n03_q0.75_R
run n03_q0.75_TS
echo "end=$(date)"
echo "finished: $(grep -l 'ORCA TERMINATED NORMALLY' */job.out 2>/dev/null | wc -l) of 27"
