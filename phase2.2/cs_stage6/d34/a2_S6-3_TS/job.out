NAME = job.inp
|  1> ! CAM-B3LYP D3BJ def2-SVPD def2/J RIJCOSX TightSCF QMMM EnGrad
|  2> %maxcore 3000
|  3> %pal nprocs 8 end
|  4> %scf
|  5>   MaxIter 300
|  6>   STABPerform true
|  7> end
|  8> %qmmm
|  9>   QMAtoms {0:23} end
| 10>   ORCAFFFilename "site.ORCAFF.prms"
| 11> end
| 12> * xyzfile -2 1 combined.xyz
| 13> 
| 14>                          ****END OF INPUT****
