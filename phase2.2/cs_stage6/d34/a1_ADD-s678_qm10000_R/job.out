|  3> %pal nprocs 8 end
|  4> %scf MaxIter 300 end
|  5> %qmmm
|  6>   QMAtoms {0:23} end
|  7>   ORCAFFFilename "site.ORCAFF.prms"
|  8> end
|  9> * xyzfile -2 1 combined.xyz
| 10> 
| 11>                          ****END OF INPUT****
