|  3> %pal nprocs 8 end
|  4> %scf
|  5>   MaxIter 300
|  6>   STABPerform true
|  7> end
|  8> %qmmm
|  9>   QMAtoms {0:23} end
| 10>   ORCAFFFilename "site.ORCAFF.prms"
| 11> end
| 12> * xyzfile -2 1 combined.xyz
| 13> 
| 14>                          ****END OF INPUT****
