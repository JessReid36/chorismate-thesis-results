#!/bin/bash
#PBS -N cm_d32_a
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d32/run_a.pbs.out
# Stage 6 DIAGNOSTIC 32, job A: the +-1 question. CAM-B3LYP/def2-SVPD with an argon ECP wall at every charge,
# STABPerform on every run. No -q: the allocation is automatic and 24:00:00 routes through workq
# to day. Ordered ascending in Sigma|q|. Restartable: resubmit and it skips what finished.
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d32
cd "$W" || exit 1
if ! mkdir .running_a 2>/dev/null; then echo "FAIL: another job holds .running_a in $W"; exit 1; fi
trap 'rmdir "$W/.running_a" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
run() {
  d="$W/$1"
  if [ -s "$d/job.out" ] && grep -q "ORCA TERMINATED NORMALLY" "$d/job.out"; then echo "$1 done before"
  else ( cd "$d" && "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
# --- Sigma|q| = 1.00 e ---
run A/n01_R
run A/n01_TS
run B/n01_q1.00_R
run B/n01_q1.00_TS
# --- Sigma|q| = 2.00 e ---
run A/n02_R
run A/n02_TS
run B/n02_q1.00_R
run B/n02_q1.00_TS
# --- Sigma|q| = 3.00 e ---
run A/n03_R
run A/n03_TS
run B/n03_q1.00_R
run B/n03_q1.00_TS
# --- Sigma|q| = 5.00 e ---
run A/n05_R
run A/n05_TS
run B/n05_q1.00_R
run B/n05_q1.00_TS
# --- Sigma|q| = 10.00 e ---
run A/n10_R
run A/n10_TS
run B/n10_q1.00_R
run B/n10_q1.00_TS
# --- Sigma|q| = 20.00 e ---
run A/n20_R
run A/n20_TS
run B/n20_q1.00_R
run B/n20_q1.00_TS
echo "end=$(date)"
echo "normal terminations in this job: $(for d in A/n01_R A/n01_TS B/n01_q1.00_R B/n01_q1.00_TS A/n02_R A/n02_TS B/n02_q1.00_R B/n02_q1.00_TS A/n03_R A/n03_TS B/n03_q1.00_R B/n03_q1.00_TS A/n05_R A/n05_TS B/n05_q1.00_R B/n05_q1.00_TS A/n10_R A/n10_TS B/n10_q1.00_R B/n10_q1.00_TS A/n20_R A/n20_TS B/n20_q1.00_R B/n20_q1.00_TS; do grep -l 'ORCA TERMINATED NORMALLY' "$W/$d/job.out" 2>/dev/null; done | wc -l) of 24"
