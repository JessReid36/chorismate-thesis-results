#!/bin/bash
#PBS -N cm_d32_b
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d32/run_b.pbs.out
# Stage 6 DIAGNOSTIC 32, job B: the rest of the ladder and the wall-only controls. CAM-B3LYP/def2-SVPD with an argon ECP wall at every charge,
# STABPerform on every run. No -q: the allocation is automatic and 24:00:00 routes through workq
# to day. Ordered ascending in Sigma|q|. Restartable: resubmit and it skips what finished.
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d32
cd "$W" || exit 1
if ! mkdir .running_b 2>/dev/null; then echo "FAIL: another job holds .running_b in $W"; exit 1; fi
trap 'rmdir "$W/.running_b" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
run() {
  d="$W/$1"
  if [ -s "$d/job.out" ] && grep -q "ORCA TERMINATED NORMALLY" "$d/job.out"; then echo "$1 done before"
  else ( cd "$d" && "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
# --- Sigma|q| = 0.00 e ---
run wall0/n01_R
run wall0/n01_TS
run wall0/n05_R
run wall0/n05_TS
run wall0/n20_R
run wall0/n20_TS
# --- Sigma|q| = 0.25 e ---
run B/n01_q0.25_R
run B/n01_q0.25_TS
# --- Sigma|q| = 0.50 e ---
run B/n01_q0.50_R
run B/n01_q0.50_TS
run B/n02_q0.25_R
run B/n02_q0.25_TS
# --- Sigma|q| = 0.75 e ---
run B/n01_q0.75_R
run B/n01_q0.75_TS
run B/n03_q0.25_R
run B/n03_q0.25_TS
# --- Sigma|q| = 1.00 e ---
run B/n02_q0.50_R
run B/n02_q0.50_TS
# --- Sigma|q| = 1.25 e ---
run B/n05_q0.25_R
run B/n05_q0.25_TS
# --- Sigma|q| = 1.50 e ---
run B/n02_q0.75_R
run B/n02_q0.75_TS
run B/n03_q0.50_R
run B/n03_q0.50_TS
# --- Sigma|q| = 2.25 e ---
run B/n03_q0.75_R
run B/n03_q0.75_TS
# --- Sigma|q| = 2.50 e ---
run B/n05_q0.50_R
run B/n05_q0.50_TS
run B/n10_q0.25_R
run B/n10_q0.25_TS
# --- Sigma|q| = 3.75 e ---
run B/n05_q0.75_R
run B/n05_q0.75_TS
# --- Sigma|q| = 5.00 e ---
run B/n10_q0.50_R
run B/n10_q0.50_TS
run B/n20_q0.25_R
run B/n20_q0.25_TS
# --- Sigma|q| = 7.50 e ---
run B/n10_q0.75_R
run B/n10_q0.75_TS
# --- Sigma|q| = 10.00 e ---
run B/n20_q0.50_R
run B/n20_q0.50_TS
# --- Sigma|q| = 15.00 e ---
run B/n20_q0.75_R
run B/n20_q0.75_TS
echo "end=$(date)"
echo "normal terminations in this job: $(for d in wall0/n01_R wall0/n01_TS wall0/n05_R wall0/n05_TS wall0/n20_R wall0/n20_TS B/n01_q0.25_R B/n01_q0.25_TS B/n01_q0.50_R B/n01_q0.50_TS B/n02_q0.25_R B/n02_q0.25_TS B/n01_q0.75_R B/n01_q0.75_TS B/n03_q0.25_R B/n03_q0.25_TS B/n02_q0.50_R B/n02_q0.50_TS B/n05_q0.25_R B/n05_q0.25_TS B/n02_q0.75_R B/n02_q0.75_TS B/n03_q0.50_R B/n03_q0.50_TS B/n03_q0.75_R B/n03_q0.75_TS B/n05_q0.50_R B/n05_q0.50_TS B/n10_q0.25_R B/n10_q0.25_TS B/n05_q0.75_R B/n05_q0.75_TS B/n10_q0.50_R B/n10_q0.50_TS B/n20_q0.25_R B/n20_q0.25_TS B/n10_q0.75_R B/n10_q0.75_TS B/n20_q0.50_R B/n20_q0.50_TS B/n20_q0.75_R B/n20_q0.75_TS; do grep -l 'ORCA TERMINATED NORMALLY' "$W/$d/job.out" 2>/dev/null; done | wc -l) of 42"
