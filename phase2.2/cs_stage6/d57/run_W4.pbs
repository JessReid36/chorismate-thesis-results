#!/bin/bash
#PBS -N cm_d57_w4
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d57/run_W4.pbs.out
# Stage 6 DIAGNOSTIC 57: D56's best-ranked failed designs behind the wall, and the wall against real ions (AMENDMENT 12).
# Job W4 of 9. It makes 16 runs in the order below (name, cap in s); a run that fails does not stop the ones after it.
# No -q: the allocation is automatic and walltime 24:00:00 routes to day. The job script is D56's committed run_C0.pbs
# with its names, runs and caps changed. No run is made twice:
#   submitted again, it makes only the runs whose folder holds no output yet (D44 NOTE 3).
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d57
cd "$W" || exit 1
if ! mkdir .running_W4 2>/dev/null; then echo "FAIL: another job holds .running_W4 in $W"; exit 1; fi
trap 'rmdir "$W/.running_W4" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
echo "free memory at start:"; free -g | head -2
run() {
  d="$W/$1"
  if [ -e "$d/job.out" ]; then echo "$1 has an output already: not run again"
  else ( cd "$d" && timeout -k 10 "$2" "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
run SV_AHe_S_n20_k1_di_R 1800
run SV_AHe_S_n20_k1_di_TS 1800
run SV_AHe_S_n20_k1_mo_R 1800
run SV_AHe_S_n20_k1_mo_TS 1800
run TZ_AHe_S_n20_k1_di_R 5000
run TZ_AHe_S_n20_k1_di_TS 5000
run TZ_AHe_S_n20_k1_mo_R 5000
run TZ_AHe_S_n20_k1_mo_TS 5000
run SV_ANe_S_n20_k1_di_R 1800
run SV_ANe_S_n20_k1_di_TS 1800
run SV_ANe_S_n20_k1_mo_R 1800
run SV_ANe_S_n20_k1_mo_TS 1800
run TZ_ANe_S_n20_k1_di_R 5000
run TZ_ANe_S_n20_k1_di_TS 5000
run TZ_ANe_S_n20_k1_mo_R 5000
run TZ_ANe_S_n20_k1_mo_TS 5000
echo "end=$(date)"
n=0; for r in SV_AHe_S_n20_k1_di_R SV_AHe_S_n20_k1_di_TS SV_AHe_S_n20_k1_mo_R SV_AHe_S_n20_k1_mo_TS TZ_AHe_S_n20_k1_di_R TZ_AHe_S_n20_k1_di_TS TZ_AHe_S_n20_k1_mo_R TZ_AHe_S_n20_k1_mo_TS SV_ANe_S_n20_k1_di_R SV_ANe_S_n20_k1_di_TS SV_ANe_S_n20_k1_mo_R SV_ANe_S_n20_k1_mo_TS TZ_ANe_S_n20_k1_di_R TZ_ANe_S_n20_k1_di_TS TZ_ANe_S_n20_k1_mo_R TZ_ANe_S_n20_k1_mo_TS; do grep -q 'ORCA TERMINATED NORMALLY' "$W/$r/job.out" 2>/dev/null && n=$((n+1)); done
echo "finished: $n of 16"
