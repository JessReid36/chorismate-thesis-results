|  2> %maxcore 3000
|  3> %pal nprocs 8 end
|  4> %scf
|  5>   MaxIter 300
|  6>   STABPerform true
|  7> end
|  8> %pointcharges "pc.pc"
|  9> * xyzfile -2 1 substrate.xyz
| 10> 
| 11>                          ****END OF INPUT****
