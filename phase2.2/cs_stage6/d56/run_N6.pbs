#!/bin/bash
#PBS -N cm_d56_n6
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d56/run_N6.pbs.out
# Stage 6 DIAGNOSTIC 56: the search on the committed grid, each design measured at two levels.
# Job N6 of 10: the 3 designs of 10 charges, at both levels. It makes 24 runs in the order below (name, cap in s); a run that fails does not stop the ones after it.
# No -q: the allocation is automatic and walltime 24:00:00 routes to day. No run is made twice:
#   submitted again, it makes only the runs whose folder holds no output yet (D44 NOTE 3).
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d56
cd "$W" || exit 1
if ! mkdir .running_N6 2>/dev/null; then echo "FAIL: another job holds .running_N6 in $W"; exit 1; fi
trap 'rmdir "$W/.running_N6" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
echo "free memory at start:"; free -g | head -2
run() {
  d="$W/$1"
  if [ -e "$d/job.out" ]; then echo "$1 has an output already: not run again"
  else ( cd "$d" && timeout -k 10 "$2" "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
run SV_S_n10_k1_di_R 1800
run SV_S_n10_k1_di_TS 1800
run SV_S_n10_k2_di_R 1800
run SV_S_n10_k2_di_TS 1800
run SV_S_n10_k3_di_R 1800
run SV_S_n10_k3_di_TS 1800
run SV_S_n10_k1_mo_R 1800
run SV_S_n10_k1_mo_TS 1800
run SV_S_n10_k2_mo_R 1800
run SV_S_n10_k2_mo_TS 1800
run SV_S_n10_k3_mo_R 1800
run SV_S_n10_k3_mo_TS 1800
run TZ_S_n10_k1_di_R 5000
run TZ_S_n10_k1_di_TS 5000
run TZ_S_n10_k2_di_R 5000
run TZ_S_n10_k2_di_TS 5000
run TZ_S_n10_k3_di_R 5000
run TZ_S_n10_k3_di_TS 5000
run TZ_S_n10_k1_mo_R 5000
run TZ_S_n10_k1_mo_TS 5000
run TZ_S_n10_k2_mo_R 5000
run TZ_S_n10_k2_mo_TS 5000
run TZ_S_n10_k3_mo_R 5000
run TZ_S_n10_k3_mo_TS 5000
echo "end=$(date)"
n=0; for r in SV_S_n10_k1_di_R SV_S_n10_k1_di_TS SV_S_n10_k2_di_R SV_S_n10_k2_di_TS SV_S_n10_k3_di_R SV_S_n10_k3_di_TS SV_S_n10_k1_mo_R SV_S_n10_k1_mo_TS SV_S_n10_k2_mo_R SV_S_n10_k2_mo_TS SV_S_n10_k3_mo_R SV_S_n10_k3_mo_TS TZ_S_n10_k1_di_R TZ_S_n10_k1_di_TS TZ_S_n10_k2_di_R TZ_S_n10_k2_di_TS TZ_S_n10_k3_di_R TZ_S_n10_k3_di_TS TZ_S_n10_k1_mo_R TZ_S_n10_k1_mo_TS TZ_S_n10_k2_mo_R TZ_S_n10_k2_mo_TS TZ_S_n10_k3_mo_R TZ_S_n10_k3_mo_TS; do grep -q 'ORCA TERMINATED NORMALLY' "$W/$r/job.out" 2>/dev/null && n=$((n+1)); done
echo "finished: $n of 24"
