#!/bin/bash
#PBS -N cm_d58_m1
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d58/run_M1.pbs.out
# Stage 6 DIAGNOSTIC 58: the force each survivor of D56 adds, and the first-order maps of the force and of the
# hold on the last electron (AMENDMENT 13, A13.4 items 2 to 4).
# Job M1 of 8. It makes 48 runs in the order below (name, cap in s), each followed by orca_vpot at the 2626 sites; a run that fails does not stop the ones after it.
# No -q: the allocation is automatic and walltime 24:00:00 routes to day. The job script is FORMS TEST 1's committed
# run_F1.pbs with its names, runs and caps changed. No run is made twice:
#   submitted again, it makes only the runs whose folder holds no output yet (D44 NOTE 3).
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d58
cd "$W" || exit 1
if ! mkdir .running_M1 2>/dev/null; then echo "FAIL: another job holds .running_M1 in $W"; exit 1; fi
trap 'rmdir "$W/.running_M1" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
echo "free memory at start:"; free -g | head -2
run() {
  d="$W/$1"
  if [ -e "$d/job.out" ]; then echo "$1 has an output already: not run again"
  else ( cd "$d" && timeout -k 10 "$2" "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
vpot() {
  d="$W/$1"; pts="$W/points.xyz"
  if [ -e "$d/vpot.log" ]; then echo "$1 vpot has a log already: not run again"; return; fi
  if ! grep -q "ORCA TERMINATED NORMALLY" "$d/job.out" 2>/dev/null; then echo "$1 vpot skipped, run not normal"; return; fi
  ( cd "$d" && "$ORCA/orca_vpot" job.gbw job.scfp "$pts" vpot.out job > vpot.log 2>&1 )
  echo "$1 vpot_exit=$? lines=$(wc -l < "$d/vpot.out" 2>/dev/null || echo 0) expected=2627"
}
run M_a00_x_p 900
vpot M_a00_x_p
run M_a00_x_m 900
vpot M_a00_x_m
run M_a00_y_p 900
vpot M_a00_y_p
run M_a00_y_m 900
vpot M_a00_y_m
run M_a00_z_p 900
vpot M_a00_z_p
run M_a00_z_m 900
vpot M_a00_z_m
run M_a01_x_p 900
vpot M_a01_x_p
run M_a01_x_m 900
vpot M_a01_x_m
run M_a01_y_p 900
vpot M_a01_y_p
run M_a01_y_m 900
vpot M_a01_y_m
run M_a01_z_p 900
vpot M_a01_z_p
run M_a01_z_m 900
vpot M_a01_z_m
run M_a02_x_p 900
vpot M_a02_x_p
run M_a02_x_m 900
vpot M_a02_x_m
run M_a02_y_p 900
vpot M_a02_y_p
run M_a02_y_m 900
vpot M_a02_y_m
run M_a02_z_p 900
vpot M_a02_z_p
run M_a02_z_m 900
vpot M_a02_z_m
run M_a03_x_p 900
vpot M_a03_x_p
run M_a03_x_m 900
vpot M_a03_x_m
run M_a03_y_p 900
vpot M_a03_y_p
run M_a03_y_m 900
vpot M_a03_y_m
run M_a03_z_p 900
vpot M_a03_z_p
run M_a03_z_m 900
vpot M_a03_z_m
run M_a04_x_p 900
vpot M_a04_x_p
run M_a04_x_m 900
vpot M_a04_x_m
run M_a04_y_p 900
vpot M_a04_y_p
run M_a04_y_m 900
vpot M_a04_y_m
run M_a04_z_p 900
vpot M_a04_z_p
run M_a04_z_m 900
vpot M_a04_z_m
run M_a05_x_p 900
vpot M_a05_x_p
run M_a05_x_m 900
vpot M_a05_x_m
run M_a05_y_p 900
vpot M_a05_y_p
run M_a05_y_m 900
vpot M_a05_y_m
run M_a05_z_p 900
vpot M_a05_z_p
run M_a05_z_m 900
vpot M_a05_z_m
run M_a06_x_p 900
vpot M_a06_x_p
run M_a06_x_m 900
vpot M_a06_x_m
run M_a06_y_p 900
vpot M_a06_y_p
run M_a06_y_m 900
vpot M_a06_y_m
run M_a06_z_p 900
vpot M_a06_z_p
run M_a06_z_m 900
vpot M_a06_z_m
run M_a07_x_p 900
vpot M_a07_x_p
run M_a07_x_m 900
vpot M_a07_x_m
run M_a07_y_p 900
vpot M_a07_y_p
run M_a07_y_m 900
vpot M_a07_y_m
run M_a07_z_p 900
vpot M_a07_z_p
run M_a07_z_m 900
vpot M_a07_z_m
echo "end=$(date)"
n=0; for r in M_a00_x_p M_a00_x_m M_a00_y_p M_a00_y_m M_a00_z_p M_a00_z_m M_a01_x_p M_a01_x_m M_a01_y_p M_a01_y_m M_a01_z_p M_a01_z_m M_a02_x_p M_a02_x_m M_a02_y_p M_a02_y_m M_a02_z_p M_a02_z_m M_a03_x_p M_a03_x_m M_a03_y_p M_a03_y_m M_a03_z_p M_a03_z_m M_a04_x_p M_a04_x_m M_a04_y_p M_a04_y_m M_a04_z_p M_a04_z_m M_a05_x_p M_a05_x_m M_a05_y_p M_a05_y_m M_a05_z_p M_a05_z_m M_a06_x_p M_a06_x_m M_a06_y_p M_a06_y_m M_a06_z_p M_a06_z_m M_a07_x_p M_a07_x_m M_a07_y_p M_a07_y_m M_a07_z_p M_a07_z_m; do grep -q 'ORCA TERMINATED NORMALLY' "$W/$r/job.out" 2>/dev/null && n=$((n+1)); done
echo "finished: $n of 48"
