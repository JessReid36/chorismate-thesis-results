|  1> ! DLPNO-CCSD(T) def2-TZVPD AutoAux TightSCF TightPNO
|  2> %maxcore 8000
|  3> %pal nprocs 16 end
|  4> %scf MaxIter 300 end
|  5> %mdci
|  6>      StorageType Shared
|  7> end
|  8> * xyzfile -2 1 substrate.xyz
|  9> 
| 10>                          ****END OF INPUT****
