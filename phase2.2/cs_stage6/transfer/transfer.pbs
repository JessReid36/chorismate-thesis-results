#!/bin/bash
#PBS -N cm_s6t
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=12:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/transfer/transfer.pbs.out
# Stage 6 DIAGNOSTIC 7 (cs6_transfer.py): 24 single points. Restartable.
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/transfer
cd "$W" || exit 1
if ! mkdir .running 2>/dev/null; then echo "FAIL: another job holds .running"; exit 1; fi
trap 'rmdir "$W/.running" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
run() {
  d="$W/$1"
  if [ -s "$d/job.out" ] && grep -q "ORCA TERMINATED NORMALLY" "$d/job.out"; then echo "$1 done before"
  else ( cd "$d" && "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
run def2-SVP/lam025_R
run def2-SVP/lam025_TS
run def2-SVP/lamM1_R
run def2-SVP/lamM1_TS
run def2-SVP/lam050_R
run def2-SVP/lam050_TS
run def2-SVP/lamM2_R
run def2-SVP/lamM2_TS
run def2-SVP/lam075_R
run def2-SVP/lam075_TS
run def2-SVP/lam100_R
run def2-SVP/lam100_TS
run def2-SVPD/lam025_R
run def2-SVPD/lam025_TS
run def2-SVPD/lamM1_R
run def2-SVPD/lamM1_TS
run def2-SVPD/lam050_R
run def2-SVPD/lam050_TS
run def2-SVPD/lamM2_R
run def2-SVPD/lamM2_TS
run def2-SVPD/lam075_R
run def2-SVPD/lam075_TS
run def2-SVPD/lam100_R
run def2-SVPD/lam100_TS
echo "end=$(date)"
