|  3> %pal nprocs 8 end
|  4> %scf
|  5>   MaxIter 300
|  6>   STABPerform true
|  7> end
|  8> %method
|  9>   SpecialGridAtoms 1
| 10>   SpecialGridIntAcc 12.0
| 11> end
| 12> %pointcharges "pc.pc"
| 13> * xyzfile -2 1 substrate.xyz
| 14> 
