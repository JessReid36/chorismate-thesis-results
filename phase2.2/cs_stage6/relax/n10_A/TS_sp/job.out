NAME = job.inp
|  1> ! B3LYP D3BJ def2-SVP def2/J RIJCOSX TightSCF QMMM EnGrad
|  2> %maxcore 3000
|  3> %pal nprocs 8 end
|  4> %scf MaxIter 250 end
|  5> %qmmm
|  6>   QMAtoms {0:23} end
|  7>   ORCAFFFilename "site.ORCAFF.prms"
|  8> end
|  9> * xyzfile -2 1 combined.xyz
| 10> 
| 11>                          ****END OF INPUT****
