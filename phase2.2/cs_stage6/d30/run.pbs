#!/bin/bash
#PBS -N cm_d30
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d30/run.pbs.out
# Stage 6 DIAGNOSTIC 30: 22 single points under CAM-B3LYP. Two arms. Restartable.
# No -q is given: the allocation is automatic, and walltime 24:00:00 routes through workq to day.
#
# Order is deliberate. gap_DT needs only def2-TZVPD and the def2-SVPD arms d28 already committed,
# so the def2-TZVPD pair at 2.8800 e comes first: that is the vector where B3LYP said NOT
# CONVERGING, and those two runs answer the main question on their own. Then the other two vectors,
# then def2-SVP for gap_SD, then Arm B. An early look is informative at every stage.
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d30
cd "$W" || exit 1
if ! mkdir .running 2>/dev/null; then echo "FAIL: another job holds .running in $W"; exit 1; fi
trap 'rmdir "$W/.running" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
run() {
  d="$W/$1"
  if [ -s "$d/job.out" ] && grep -q "ORCA TERMINATED NORMALLY" "$d/job.out"; then echo "$1 done before"
  else ( cd "$d" && "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
# --- the crux: gap_DT at the vector B3LYP called NOT CONVERGING -------------
run A/def2-TZVPD/2.8800e_n10_R
run A/def2-TZVPD/2.8800e_n10_TS
# --- the vector B3LYP called CONVERGED, as the check that the sequence behaves
run A/def2-TZVPD/1.3000e_n10_R
run A/def2-TZVPD/1.3000e_n10_TS
# --- the worst vector, and the most expensive
run A/def2-TZVPD/5.6433e_n20_R
run A/def2-TZVPD/5.6433e_n20_TS
# --- def2-SVP, for gap_SD. Controls first.
run A/def2-SVP/ctl_R
run A/def2-SVP/ctl_TS
run A/def2-SVP/1.3000e_n10_R
run A/def2-SVP/1.3000e_n10_TS
run A/def2-SVP/2.8800e_n10_R
run A/def2-SVP/2.8800e_n10_TS
run A/def2-SVP/5.6433e_n20_R
run A/def2-SVP/5.6433e_n20_TS
# --- Arm B, the stability analysis. The control carries the test, so it goes first.
run B/def2-SVPD/ctl_R
run B/def2-SVPD/ctl_TS
run B/def2-SVPD/1.3000e_n10_R
run B/def2-SVPD/1.3000e_n10_TS
run B/def2-SVPD/2.8800e_n10_R
run B/def2-SVPD/2.8800e_n10_TS
run B/def2-SVPD/5.6433e_n20_R
run B/def2-SVPD/5.6433e_n20_TS
echo "end=$(date)"
echo "normal terminations: $(grep -l 'ORCA TERMINATED NORMALLY' "$W"/*/*/*/job.out 2>/dev/null | wc -l) of 22"
