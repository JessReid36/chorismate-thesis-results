echo "end=$(date)"
n=0; for r in ONE_HF_X2_p010 ONE_HF_X2_p015 ONE_HF_X2_p020 ONE_HF_X2_p025 ONE_HF_X2_p030 ONE_HF_X2_p040 ONE_HF_X2_p050 ONE_HF_X2_p060 ONE_HF_X2_p075 ONE_HF_X2_p100 ONE_CAM_X2A_p010 ONE_CAM_X2A_p015 ONE_CAM_X2A_p020 ONE_CAM_X2A_p025 ONE_CAM_X2A_p030 ONE_CAM_X2A_p040 ONE_CAM_X2A_p050 ONE_CAM_X2A_p060 ONE_CAM_X2A_p075 ONE_CAM_X2A_p100 ONE_CAM_X2E_p010 ONE_CAM_X2E_p015 ONE_CAM_X2E_p020 ONE_CAM_X2E_p025 ONE_CAM_X2E_p030 ONE_CAM_X2E_p040 ONE_CAM_X2E_p050 ONE_CAM_X2E_p060 ONE_CAM_X2E_p075 ONE_CAM_X2E_p100 ONE_CAM_X2J_p010 ONE_CAM_X2J_p015 ONE_CAM_X2J_p020 ONE_CAM_X2J_p025 ONE_CAM_X2J_p030 ONE_CAM_X2J_p040 ONE_CAM_X2J_p050 ONE_CAM_X2J_p060 ONE_CAM_X2J_p075 ONE_CAM_X2J_p100 ONE_HF_X3_p010 ONE_HF_X3_p015 ONE_HF_X3_p020 ONE_HF_X3_p025 ONE_HF_X3_p030 ONE_HF_X3_p040 ONE_HF_X3_p050 ONE_HF_X3_p060 ONE_HF_X3_p075 ONE_HF_X3_p100 ONE_CAM_X3A_p010 ONE_CAM_X3A_p015 ONE_CAM_X3A_p020 ONE_CAM_X3A_p025 ONE_CAM_X3A_p030 ONE_CAM_X3A_p040 ONE_CAM_X3A_p050 ONE_CAM_X3A_p060 ONE_CAM_X3A_p075 ONE_CAM_X3A_p100 ONE_CAM_X3E_p010 ONE_CAM_X3E_p015 ONE_CAM_X3E_p020 ONE_CAM_X3E_p025 ONE_CAM_X3E_p030 ONE_CAM_X3E_p040 ONE_CAM_X3E_p050 ONE_CAM_X3E_p060 ONE_CAM_X3E_p075 ONE_CAM_X3E_p100 ONE_CAM_X3J_p010 ONE_CAM_X3J_p015 ONE_CAM_X3J_p020 ONE_CAM_X3J_p025 ONE_CAM_X3J_p030 ONE_CAM_X3J_p040 ONE_CAM_X3J_p050 ONE_CAM_X3J_p060 ONE_CAM_X3J_p075 ONE_CAM_X3J_p100; do grep -q 'ORCA TERMINATED NORMALLY' "$W/$r/job.out" 2>/dev/null && n=$((n+1)); done
