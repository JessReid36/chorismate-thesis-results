NAME = job.inp
|  1> ! IP-EOM-DLPNO-CCSD def2-SVPD AutoAux TightSCF TightPNO
|  2> %maxcore 6000
|  3> %pal nprocs 16 end
|  4> %scf MaxIter 300 end
|  5> %mdci nroots 2 end
|  6> %pointcharges "charge.pc"
|  7> * xyzfile -2 1 substrate.xyz
|  8> 
|  9>                          ****END OF INPUT****
