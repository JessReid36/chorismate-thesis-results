#!/bin/bash
#PBS -N cm_d61_j03
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d61/run_J03.pbs.out
# Stage 6 DIAGNOSTIC 61: D59's test of the functions at the positive charges of the ten survivors, made again for the
# runs that carry ghost atoms, each ghost centre 0.01 A beyond its charge (D59 NOTE 1).
# Job J03 of 13. It makes 12 runs in the order below (name, cap in s); a run that fails does not stop the ones after it.
# No -q: the allocation is automatic and walltime 24:00:00 routes to day. The job script is D59's committed run_J01.pbs
# with its names, runs and caps changed. No run is made twice:
#   submitted again, it makes only the runs whose folder holds no output yet (D44 NOTE 3).
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d61
cd "$W" || exit 1
if ! mkdir .running_J03 2>/dev/null; then echo "FAIL: another job holds .running_J03 in $W"; exit 1; fi
trap 'rmdir "$W/.running_J03" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
echo "free memory at start:"; free -g | head -2
run() {
  d="$W/$1"
  if [ -e "$d/job.out" ]; then echo "$1 has an output already: not run again"
  else ( cd "$d" && timeout -k 10 "$2" "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
run HF_F_S_n08_k2_TS 4500
run HF_GF_S_n08_k2_TS 4500
run HF_F_S_n08_k3_TS 4500
run HF_GF_S_n08_k3_TS 4500
run HF_F_S_n08_k1_TS 4500
run HF_GF_S_n08_k1_TS 4500
run HF_F_S_n10_k2_TS 4500
run HF_GF_S_n10_k2_TS 4500
run HF_F_S_n10_k3_TS 4500
run HF_GF_S_n10_k3_TS 4500
run HF_F_S_n10_k1_TS 4500
run HF_GF_S_n10_k1_TS 4500
echo "end=$(date)"
n=0; for r in HF_F_S_n08_k2_TS HF_GF_S_n08_k2_TS HF_F_S_n08_k3_TS HF_GF_S_n08_k3_TS HF_F_S_n08_k1_TS HF_GF_S_n08_k1_TS HF_F_S_n10_k2_TS HF_GF_S_n10_k2_TS HF_F_S_n10_k3_TS HF_GF_S_n10_k3_TS HF_F_S_n10_k1_TS HF_GF_S_n10_k1_TS; do grep -q 'ORCA TERMINATED NORMALLY' "$W/$r/job.out" 2>/dev/null && n=$((n+1)); done
echo "finished: $n of 12"
