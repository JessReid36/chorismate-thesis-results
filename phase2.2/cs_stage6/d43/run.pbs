#!/bin/bash
#PBS -N cm_d43
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d43/run.pbs.out
# Stage 6 DIAGNOSTIC 43: bare charges at or beyond r_safe, on the committed grid.
# C_ctl_R is D31's committed charge-free dianion input and C_bare_R is D40's committed
#   monoanion input for the bare substrate, each byte for byte: the two CONTROLS.
# Every other condition is run four times with one point-charge file: the dianion (di) and
#   the monoanion (mo), at the reactant and at the transition state.
# Order: the controls; the six designs of part B; the six charges of +1.00 e of part A;
#   then its six charges of -1.00 e. A run that fails does not stop the ones after it.
# No -q: the allocation is automatic and walltime 24:00:00 routes to day. Restartable:
#   submitted again, it skips every run that ended normally.
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d43
cd "$W" || exit 1
if ! mkdir .running 2>/dev/null; then echo "FAIL: another job holds .running in $W"; exit 1; fi
trap 'rmdir "$W/.running" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
echo "free memory at start:"; free -g | head -2
run() {
  d="$W/$1"
  if [ -s "$d/job.out" ] && grep -q "ORCA TERMINATED NORMALLY" "$d/job.out"; then echo "$1 done before"
  else ( cd "$d" && "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
run C_ctl_R
run C_bare_R
run B_n02_q0.50_di_R
run B_n02_q0.50_di_TS
run B_n02_q0.50_mo_R
run B_n02_q0.50_mo_TS
run B_n02_q0.75_di_R
run B_n02_q0.75_di_TS
run B_n02_q0.75_mo_R
run B_n02_q0.75_mo_TS
run B_n02_q1.00_di_R
run B_n02_q1.00_di_TS
run B_n02_q1.00_mo_R
run B_n02_q1.00_mo_TS
run B_n03_q0.75_di_R
run B_n03_q0.75_di_TS
run B_n03_q0.75_mo_R
run B_n03_q0.75_mo_TS
run B_n05_q0.50_di_R
run B_n05_q0.50_di_TS
run B_n05_q0.50_mo_R
run B_n05_q0.50_mo_TS
run B_n11_q0.25_di_R
run B_n11_q0.25_di_TS
run B_n11_q0.25_mo_R
run B_n11_q0.25_mo_TS
run A_s1124_p100_di_R
run A_s1124_p100_di_TS
run A_s1124_p100_mo_R
run A_s1124_p100_mo_TS
run A_s0557_p100_di_R
run A_s0557_p100_di_TS
run A_s0557_p100_mo_R
run A_s0557_p100_mo_TS
run A_s0004_p100_di_R
run A_s0004_p100_di_TS
run A_s0004_p100_mo_R
run A_s0004_p100_mo_TS
run A_s0396_p100_di_R
run A_s0396_p100_di_TS
run A_s0396_p100_mo_R
run A_s0396_p100_mo_TS
run A_s0397_p100_di_R
run A_s0397_p100_di_TS
run A_s0397_p100_mo_R
run A_s0397_p100_mo_TS
run A_s1043_p100_di_R
run A_s1043_p100_di_TS
run A_s1043_p100_mo_R
run A_s1043_p100_mo_TS
run A_s1124_m100_di_R
run A_s1124_m100_di_TS
run A_s1124_m100_mo_R
run A_s1124_m100_mo_TS
run A_s0557_m100_di_R
run A_s0557_m100_di_TS
run A_s0557_m100_mo_R
run A_s0557_m100_mo_TS
run A_s0004_m100_di_R
run A_s0004_m100_di_TS
run A_s0004_m100_mo_R
run A_s0004_m100_mo_TS
run A_s0396_m100_di_R
run A_s0396_m100_di_TS
run A_s0396_m100_mo_R
run A_s0396_m100_mo_TS
run A_s0397_m100_di_R
run A_s0397_m100_di_TS
run A_s0397_m100_mo_R
run A_s0397_m100_mo_TS
run A_s1043_m100_di_R
run A_s1043_m100_di_TS
run A_s1043_m100_mo_R
run A_s1043_m100_mo_TS
echo "end=$(date)"
echo "finished: $(grep -l 'ORCA TERMINATED NORMALLY' */job.out 2>/dev/null | wc -l) of 74"
