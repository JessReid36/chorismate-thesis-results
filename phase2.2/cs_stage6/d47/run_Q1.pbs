#!/bin/bash
#PBS -N cm_d47_q1
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/phase2.2/cs_stage6/d47/run_Q1.pbs.out
# Stage 6 DIAGNOSTIC 47, a preliminary: when does a bare positive charge take electrons from the substrate?
# This job is one of 5. It makes 6 runs in the order below; a run that fails does not stop the ones after it.
# No -q: the allocation is automatic and walltime 24:00:00 routes to day. Restartable:
#   submitted again, it skips every run that ended normally and every map that is written.
export PATH="/apps/openmpi/4.1.1/bin:$PATH"
export LD_LIBRARY_PATH="/home/apps2/ORCA/6.0.1/lib:/apps/openmpi/4.1.1/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ORCA=/home/apps2/ORCA/6.0.1
W=/home/18660916/system_development/phase2.2/cs_stage6/d47
cd "$W" || exit 1
if ! mkdir .running_Q1 2>/dev/null; then echo "FAIL: another job holds .running_Q1 in $W"; exit 1; fi
trap 'rmdir "$W/.running_Q1" 2>/dev/null' EXIT
echo "host=$(hostname) start=$(date)"
echo "free memory at start:"; free -g | head -2
run() {
  d="$W/$1"
  if [ -s "$d/job.out" ] && grep -q "ORCA TERMINATED NORMALLY" "$d/job.out"; then echo "$1 done before"
  else ( cd "$d" && "$ORCA/orca" job.inp > job.out 2>&1 </dev/null ); echo "$1 orca_exit=$? normal=$(grep -c 'ORCA TERMINATED NORMALLY' "$d/job.out") $(date)"; fi
}
vpot() {
  d="$W/$1"; pts="$W/points.xyz"
  if [ -s "$d/vpot.out" ]; then echo "$1 vpot done before"; return; fi
  if ! grep -q "ORCA TERMINATED NORMALLY" "$d/job.out" 2>/dev/null; then echo "$1 vpot skipped, run not normal"; return; fi
  ( cd "$d" && "$ORCA/orca_vpot" job.gbw job.scfp "$pts" vpot.out job > vpot.log 2>&1 )
  echo "$1 vpot_exit=$? lines=$(wc -l < "$d/vpot.out" 2>/dev/null || echo 0) expected=2630 $(date)"
}
run Q1_C_ctl_R
run CAMQZ_B_n11_q0.25_di_R
run CAMQZ_B_n02_q0.50_di_R
run Q1_C_ctl_TS
run CAMQZ_B_n11_q0.25_di_TS
run CAMQZ_B_n02_q0.50_di_TS
echo "end=$(date)"
n=0; for r in Q1_C_ctl_R CAMQZ_B_n11_q0.25_di_R CAMQZ_B_n02_q0.50_di_R Q1_C_ctl_TS CAMQZ_B_n11_q0.25_di_TS CAMQZ_B_n02_q0.50_di_TS; do grep -q 'ORCA TERMINATED NORMALLY' "$W/$r/job.out" 2>/dev/null && n=$((n+1)); done
echo "finished: $n of 6"
